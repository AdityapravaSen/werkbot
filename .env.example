# Copy this file to .env and fill in what you use. .env is git-ignored.

# --- LLM (pick one or more; all have free options) ---
# Model names follow LiteLLM's "provider/model" format.
WERKBOT_LLM_MODEL=gemini/gemini-2.5-flash
GEMINI_API_KEY=
GROQ_API_KEY=
# For local models via Ollama, e.g. WERKBOT_LLM_MODEL=ollama/llama3.1
OLLAMA_API_BASE=http://localhost:11434

# --- Telegram (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Search settings ---
WERKBOT_HOME_CITY=Kaiserslautern
WERKBOT_MAX_DISTANCE_KM=100
WERKBOT_MAX_AGE_DAYS=7

# --- Paths (defaults are fine) ---
WERKBOT_DB_PATH=data/werkbot.db
WERKBOT_SOURCES_PATH=data/sources.yaml
WERKBOT_RESUME_PATH=data/master_resume.yaml
WERKBOT_OUTPUT_DIR=output
