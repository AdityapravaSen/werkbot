# Copy this file to .env and fill in what you use. .env is git-ignored.

# --- LLM (pick one; all have free options) ---
# Used to read the requirements of each job ad (Phase 4). Only the ad is sent, never your
# resume. Model names follow LiteLLM's "provider/model" format. Free tiers have small
# daily limits; the requests per minute/run are set in data/scoring.yaml.
#   Gemini (key: aistudio.google.com):  gemini/gemini-flash-lite-latest
#   Groq   (key: console.groq.com):     groq/openai/gpt-oss-120b
#   Ollama (local, no key, no limits):  ollama/qwen2.5:7b
WERKBOT_LLM_MODEL=gemini/gemini-flash-lite-latest,groq/openai/gpt-oss-120b mistral/mistral-small-latest
GEMINI_API_KEY=...
GROQ_API_KEY=...
MISTRAL_API_KEY=...
# Only for Ollama:
# OLLAMA_API_BASE=http://localhost:11434

# --- Telegram (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Search settings ---
WERKBOT_HOME_CITY=Kaiserslautern
WERKBOT_MAX_DISTANCE_KM=160
WERKBOT_MAX_AGE_DAYS=7

# --- Paths (defaults are fine) ---
WERKBOT_DB_PATH=data/werkbot.db
WERKBOT_SOURCES_PATH=data/sources.yaml
WERKBOT_RESUME_PATH=data/master_resume.yaml
WERKBOT_OUTPUT_DIR=output
